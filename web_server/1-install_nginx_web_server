#!/usr/bin/env bash
#Install nginx and configures it to return Holberton School
apt-get update -y
apt-get install -y nginx

cat <<"EOF" >/etc/nginx/sites-available/default
server {
  listen 80 default_server;
  root /var/www/html/;
  index index.html;
  server_name _;
  location / {
    try_files $uri $uri/ =404;
  }
}
EOF
service nginx restart
