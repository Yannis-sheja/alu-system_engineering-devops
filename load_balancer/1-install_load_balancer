#!/usr/bin/env bash
# Configures HAProxy as a round-robin load balancer for web-01 and web-02

sudo apt-get update
sudo apt-get install -y haproxy

sudo tee /etc/haproxy/haproxy.cfg > /dev/null <<'EOF'
global
    maxconn 2000
    h1-case-adjust x-served-by X-Served-By

defaults
    mode http
    option h1-case-adjust-bogus-client
    timeout connect 5s
    timeout client 50s
    timeout server 50s

frontend myfrontend
    bind *:80
    default_backend web-servers

backend web-servers
    balance roundrobin
    option httpchk GET /
    server 7402-web-01 18.170.217.131:80 check
    server 7402-web-02 18.132.98.220:80 check
EOF

sudo service haproxy restart
