#!/usr/bin/env bash
# Installs HAProxy and load balances web-01 and web-02 with roundrobin
WEB01_IP="18.170.217.131"
WEB02_IP="18.132.98.220"

apt-get update -y
apt-get install -y haproxy

# Allow HAProxy to be managed by its init script
if grep -q "^ENABLED" /etc/default/haproxy; then
  sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy
else
  echo "ENABLED=1" >>/etc/default/haproxy
fi

cat <<EOF >/etc/haproxy/haproxy.cfg
global
    log /dev/log local0
    maxconn 2048
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http-in
    bind *:80
    default_backend web-backend

backend web-backend
    balance roundrobin
    server 7402-web-01 ${WEB01_IP}:80 check
    server 7402-web-02 ${WEB02_IP}:80 check
EOF

service haproxy restart

